rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Members: any logged-in user can read all members (for email lookup)
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Groups: accessible by UID (existing member) OR by email (invited member)
    match /groups/{groupId} {
      allow read, write: if request.auth != null && (
        request.auth.uid in resource.data.memberIds ||
        (request.auth.token.email != null &&
          request.auth.token.email in resource.data.memberEmails)
      );
      allow create: if request.auth != null;
    }

    // Expenses: only accessible if user is a member of the group
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }

    // Contributions
    match /contributions/{contributionId} {
      allow read, write: if request.auth != null;
    }

    // Wallet Transactions
    match /wallet_transactions/{txId} {
      allow read, write: if request.auth != null;
    }

    // Settlements
    match /settlements/{settlementId} {
      allow read, write: if request.auth != null;
    }
  }
}
