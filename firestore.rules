rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Members: any logged-in user can read all members (for email lookup)
    // Only the owner can write their own profile
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Groups: only members of the group can read/write
    match /groups/{groupId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null;
    }

    // Expenses: only accessible if user is a member of the group
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }

    // Contributions
    match /contributions/{contributionId} {
      allow read, write: if request.auth != null;
    }

    // Wallet Transactions
    match /wallet_transactions/{txId} {
      allow read, write: if request.auth != null;
    }
  }
}
